{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keel Desktop",
  "version": "0.1.0",
  "identifier": "dev.keel.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: blob:; img-src 'self' data: blob:; frame-src 'self' data: blob:;"
    },
    "windows": [
      {
        "label": "main",
        "title": "Keel Desktop",
        "width": 1240,
        "height": 820,
        "minWidth": 880,
        "minHeight": 600,
        "backgroundColor": "#101A1C"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
