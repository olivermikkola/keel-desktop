{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keel Desktop",
  "version": "0.7.1",
  "identifier": "dev.keel.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' data: blob:; frame-src 'self' data: blob:;"
    },
    "windows": [
      {
        "label": "main",
        "title": "Keel Desktop",
        "width": 1240,
        "height": 820,
        "minWidth": 880,
        "minHeight": 600,
        "backgroundColor": "#0c1415",
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "shortDescription": "Private local AI workspace for chat, documents, and code",
    "longDescription": "Keel Desktop runs private AI models right on your computer for everyday chat, documents, spreadsheets, websites, slides, and code with your approval.",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "section": "devel",
        "depends": [
          "libssl3 | libssl3t64",
          "libgomp1"
        ]
      },
      "rpm": {
        "depends": [
          "libssl.so.3()(64bit)",
          "libgomp.so.1()(64bit)"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2QkY0OEI4MzBGRTlCRDcKUldUWG0vNHd1RWkvOWtSWFlUemVvb0xOV3J0R3MrRG5ZZjl3c2M2MlNibW1hVjhaNi9JQ3NxTzYK",
      "endpoints": [
        "https://github.com/olivermikkola/keel-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
